# ===========================================================
# GreenVision AI — Backend Environment Variables
# Copy this to backend/.env and fill in real values.
# NEVER commit the actual .env file.
# ===========================================================

# ---- Cloud Vision API (required for cloud vision inference) ----
VISION_KEY=

# ---- Local Model (set to true to use greenvision.pt instead of cloud API) ----
# When true, the backend loads backend/ml/weights/greenvision.pt (MobileNetV2)
# and runs inference locally. Requires torch + torchvision installed.
USE_LOCAL_MODEL=false

# ---- Supabase / Postgres (required for backend to start) ----
# asyncpg DSN — get from Supabase > Settings > Database > Connection string (URI mode)
# Replace [YOUR-PASSWORD] with the database password you set.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=

# ---- JWT (required — no hardcoded fallback in production) ----
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- App ----
APP_URL=http://localhost:8000
ENVIRONMENT=development
