# ============================================================
# GreenVision AI — Backend Environment Variables
# Copy this file to backend/.env and fill in your values.
# NEVER commit your actual .env file to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# asyncpg-compatible PostgreSQL DSN
DATABASE_URL="postgresql://user:password@host:5432/greenvision"

# ── Supabase (optional — only needed for Supabase-hosted DB) ─
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"

# ── JWT Authentication ────────────────────────────────────────
# Generate strong random secrets: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_ANOTHER_RANDOM_SECRET_32_CHARS"
JWT_ALGORITHM="HS256"
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ── AI/ML ─────────────────────────────────────────────────────
# Google Gemini Vision API key (cloud inference)
GEMINI_API_KEY="your-gemini-api-key"
VISION_KEY="your-cloud-vision-api-key"
VISION_API_KEY="your-vision-api-key"

# Set to "true" to use local PyTorch model (greenvision.pt) instead of cloud API
USE_LOCAL_MODEL="false"

# ── Application ───────────────────────────────────────────────
APP_URL="http://localhost:8000"
ENVIRONMENT="development"

# ── CORS (production) ────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave empty in development (localhost origins are allowed by default).
# Example: ALLOWED_ORIGINS="https://greenvision.onrender.com,https://www.greenvisionai.in"
ALLOWED_ORIGINS=""

# ── Docker Compose DB ────────────────────────────────────────
# Only needed when running via docker-compose with a local DB container
POSTGRES_USER="greenvision"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="greenvision"
